root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = tab
tab_width = 3
trim_trailing_whitespace = true
max_line_length = 80

[*.md]
trim_trailing_whitespace = false
# GitHub and npm render tabs 8 columns wide, so code examples use spaces.
indent_style = space
indent_size = 2

{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["import", "promise", "typescript", "unicorn"],
	"env": {
		"browser": true,
		"es2025": true
	},
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/coverage/**",
		"**/.smoke/**",
		"**/.tanstack/**",
		"**/routeTree.gen.ts",
		"site/versions/**",
		"site/landing/**"
	],
	"rules": {
		"no-unused-vars": "off",
		"typescript/no-unused-vars": [
			"warn",
			{
				"fix": {
					"imports": "safe-fix"
				}
			}
		],
		"import/no-cycle": "error",
		"no-restricted-imports": [
			"error",
			{
				"paths": [
					{
						"name": "effect",
						"message": "Import a subpath, e.g. effect/Effect"
					},
					{
						"name": "effect/http",
						"message": "Import a subpath, e.g. effect/http/HttpClient"
					}
				],
				"patterns": [
					{
						"group": ["node:*"],
						"message": "No Node built-ins in library code"
					}
				]
			}
		]
	},
	"overrides": [
		{
			"files": [
				"bin/**",
				"scripts/**",
				"test/**",
				"examples/**",
				"*.config.ts"
			],
			"env": { "node": true },
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "effect",
								"message": "Import a subpath, e.g. effect/Effect"
							},
							{
								"name": "effect/http",
								"message": "Import a subpath, e.g. effect/http/HttpClient"
							}
						]
					}
				]
			}
		},
		{
			"files": ["site/**"],
			"plugins": [
				"import",
				"promise",
				"typescript",
				"unicorn",
				"react",
				"jsx-a11y"
			],
			"env": { "browser": true, "node": true },
			"rules": {
				"react/exhaustive-deps": "warn",
				"jsx-a11y/alt-text": "error",
				"no-restricted-imports": "off"
			}
		}
	]
}
